{
  "schema_version": 1,
  "required_files": [
    "README.md",
    "LICENSE",
    ".gitattributes",
    "maintenance.json",
    "tools/maintain.py",
    "docs/maintenance.md",
    ".github/workflows/maintenance.yml",
    ".github/dependabot.yml",
    "examples/shot-cards/generate.py",
    "examples/shot-cards/demo.json",
    "examples/shot-cards/demo.html",
    "skills/reference-to-shot-cards/SKILL.md",
    "examples/stock-pick/plan.py",
    "examples/stock-pick/README.md",
    "examples/stock-pick/demo.json",
    "examples/stock-pick/expected.txt",
    "examples/voucher-review/reconcile.py",
    "examples/voucher-review/README.md",
    "examples/voucher-review/demo.json",
    "examples/voucher-review/expected.json",
    "docs/store-operations.md",
    "examples/training-sheet/generate.py",
    "examples/training-sheet/demo.json",
    "examples/training-sheet/README.md",
    "examples/training-sheet/expected.html",
    "examples/sales-sheet/generate.py",
    "examples/sales-sheet/demo.json",
    "examples/sales-sheet/README.md",
    "examples/sales-sheet/expected.html",
    "docs/design-delivery.md",
    "examples/copy-check/compare.py",
    "examples/copy-check/README.md",
    "examples/copy-check/expected.json",
    "examples/subtitle-notes/convert.py",
    "examples/subtitle-notes/README.md",
    "examples/subtitle-notes/expected.txt",
    "docs/office-automation.md",
    "docs/office-ocr-review.md",
    "assets/ocr-practice.png",
    "examples/work-brief/plan.py",
    "examples/work-brief/README.md",
    "examples/work-brief/sample.json",
    "examples/work-brief/expected.md",
    "examples/handoff-check/check_handoff.py",
    "examples/handoff-check/README.md",
    "examples/handoff-check/sample.json",
    "examples/handoff-check/expected.json",
    "docs/team-collaboration.md",
    "docs/team-relay.md",
    "skills/team-handoff/SKILL.md"
  ],
  "git_restore": "required",
  "samples": [
    {
      "id": "shot-cards",
      "entrypoint": "examples/shot-cards/generate.py",
      "isolated_cwd": true,
      "args": [
        "--input",
        "{root}/examples/shot-cards/demo.json",
        "--output",
        "shot-cards-demo.html"
      ],
      "timeout_seconds": 30,
      "expected_outputs": [
        {
          "path": "shot-cards-demo.html",
          "format": "text-lf",
          "reference": "examples/shot-cards/demo.html"
        }
      ]
    },
    {
      "id": "stock-pick",
      "entrypoint": "examples/stock-pick/plan.py",
      "isolated_cwd": true,
      "args": [
        "--input",
        "{root}/examples/stock-pick/demo.json",
        "--output",
        "stock-pick.txt"
      ],
      "timeout_seconds": 30,
      "expected_outputs": [
        {
          "path": "stock-pick.txt",
          "format": "text-lf",
          "reference": "examples/stock-pick/expected.txt"
        }
      ]
    },
    {
      "id": "voucher-review",
      "entrypoint": "examples/voucher-review/reconcile.py",
      "isolated_cwd": true,
      "args": [
        "--input",
        "{root}/examples/voucher-review/demo.json",
        "--output",
        "voucher-review.json"
      ],
      "timeout_seconds": 30,
      "expected_outputs": [
        {
          "path": "voucher-review.json",
          "format": "canonical-json",
          "reference": "examples/voucher-review/expected.json"
        }
      ]
    },
    {
      "id": "training-sheet",
      "entrypoint": "examples/training-sheet/generate.py",
      "isolated_cwd": true,
      "args": [
        "--input",
        "{root}/examples/training-sheet/demo.json",
        "--output",
        "training-sheet.html"
      ],
      "timeout_seconds": 30,
      "expected_outputs": [
        {
          "path": "training-sheet.html",
          "format": "text-lf",
          "reference": "examples/training-sheet/expected.html"
        }
      ]
    },
    {
      "id": "sales-sheet",
      "entrypoint": "examples/sales-sheet/generate.py",
      "isolated_cwd": true,
      "args": [
        "--input",
        "{root}/examples/sales-sheet/demo.json",
        "--output",
        "sales-sheet.html"
      ],
      "timeout_seconds": 30,
      "expected_outputs": [
        {
          "path": "sales-sheet.html",
          "format": "text-lf",
          "reference": "examples/sales-sheet/expected.html"
        }
      ]
    },
    {
      "id": "copy-check",
      "entrypoint": "examples/copy-check/compare.py",
      "isolated_cwd": true,
      "args": [
        "--source",
        "{root}/examples/copy-check/demo/source",
        "--copy",
        "{root}/examples/copy-check/demo/copy",
        "--output",
        "copy-report.json"
      ],
      "timeout_seconds": 30,
      "expected_outputs": [
        {
          "path": "copy-report.json",
          "format": "canonical-json",
          "reference": "examples/copy-check/expected.json"
        }
      ]
    },
    {
      "id": "subtitle-notes",
      "entrypoint": "examples/subtitle-notes/convert.py",
      "isolated_cwd": true,
      "args": [
        "--input",
        "{root}/examples/subtitle-notes/demo.txt",
        "--output",
        "subtitle-notes.txt"
      ],
      "timeout_seconds": 30,
      "expected_outputs": [
        {
          "path": "subtitle-notes.txt",
          "format": "text-lf",
          "reference": "examples/subtitle-notes/expected.txt"
        }
      ]
    },
    {
      "id": "work-brief",
      "entrypoint": "examples/work-brief/plan.py",
      "isolated_cwd": true,
      "args": [
        "{root}/examples/work-brief/sample.json",
        "--out",
        "work-board.md"
      ],
      "timeout_seconds": 30,
      "expected_outputs": [
        {
          "path": "work-board.md",
          "format": "text-lf",
          "reference": "examples/work-brief/expected.md"
        }
      ]
    },
    {
      "id": "handoff-check",
      "entrypoint": "examples/handoff-check/check_handoff.py",
      "isolated_cwd": true,
      "args": [
        "--input",
        "{root}/examples/handoff-check/sample.json",
        "--output",
        "result.json"
      ],
      "timeout_seconds": 30,
      "expected_outputs": [
        {
          "path": "result.json",
          "format": "canonical-json",
          "reference": "examples/handoff-check/expected.json"
        }
      ]
    }
  ]
}
